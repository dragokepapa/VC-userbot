{
  "name": "VC-Userbot",
  "description": "VC-Userbot is an advanced & powerful multi-featured Telegram userbot.",
  "logo": "https://telegra.ph/file/90128affe4ed7b70b10ab.jpg",
  "keywords": [
    "VC-userbot",
    "telegram-userbot",
    "telegram-music-bot",
    "telegram-video-bot"
  ],
  "repository": "https://github.com/dragokepapa/VC-userbot",
  "stack": "heroku-22",
  "env": {
    "API_ID": {
      "description": "Enter your api id here.",
      "required": true
    },
    "API_HASH": {
      "description": "Enter your api hash here.",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Enter your bot token here",
      "required": true
    },
    "STRING_SESSION": {
      "description": "Enter your pyrogram v2 string session here.",
      "required": true
    },
    "MONGO_DB_URL": {
      "description": "Enter your mongodb url here.",
      "required": true
    },
    "LOG_GROUP_ID": {
      "description": "Enter your private log group id here.",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "free"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"
    }
  ]
}